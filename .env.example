# ==============================================================================
# Environment Configuration Template
# Sao chép tệp này thành .env và điền các giá trị phù hợp với môi trường của bạn:
# cp .env.example .env
# ==============================================================================

# Khóa bảo mật Flask Session (Tạo chuỗi ngẫu nhiên trong môi trường production)
SECRET_KEY=your-super-secret-key-change-in-production

# Chế độ chạy OCR:
# - HYBRID_KAGGLE: Kết hợp Fast-Path (PDF số) và Kaggle Qwen2.5-VL (Ảnh scan)
# - STANDALONE: Sử dụng trực tiếp Google Gemini API cho toàn bộ các trang scan
# - LOCAL_MOCK: Giả lập phản hồi cho mục đích kiểm thử giao diện
OCR_MODE=HYBRID_KAGGLE

# Kích hoạt Tầng 1 Fast-Path Parser để bóc tách văn bản số trực tiếp (True/False)
FAST_PATH_ENABLED=true

# Ngưỡng ký tự tối thiểu để phân loại trang quét (Scan Page)
SCAN_THRESHOLD_CHARS=50

# URL Cloudflare Tunnel trỏ đến máy chủ OCR Qwen2.5-VL trên Kaggle
# Ví dụ: https://random-subdomain.trycloudflare.com/ocr
KAGGLE_ENDPOINT=https://your-tunnel-endpoint.trycloudflare.com/ocr

# Khóa API Google Gemini dự phòng (Failover) và dịch thuật kỹ thuật
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# Mô hình Gemini sử dụng cho OCR và dịch thuật
GEMINI_MODEL=gemini-flash-lite-latest

# Thời gian chờ tối đa cho các yêu cầu mạng ngoại vi (giây)
TIMEOUT_SECONDS=60

# Cấu hình AWS (Tùy chọn khi triển khai trên AWS Cloud)
AWS_REGION=ap-southeast-1
S3_BUCKET=hybrid-ocr-documents
DYNAMODB_TABLE=document_processing_jobs

# Cấu hình AWS Cognito Federated Identity (Đăng nhập Google)
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=your-cognito-client-id
COGNITO_APP_CLIENT_SECRET=your-cognito-client-secret
COGNITO_DOMAIN=https://your-cognito-domain.auth.ap-southeast-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:5000/api/auth/cognito/callback
